#!/data/data/com.termux/files/usr/bin/sh
set -eu

if ! command -v proot-distro >/dev/null 2>&1; then
    echo "==> 'proot-distro' not found, skipping proot environment setup..."
    exit 0
fi

DISTRO="{{ .proot.distro }}"

ROOTFS_DIR="${PREFIX:-/data/data/com.termux/files/usr}/var/lib/proot-distro/installed-rootfs/$DISTRO"

echo "==> Checking proot-distro '$DISTRO' installation..."
if [ ! -d "$ROOTFS_DIR" ] && ! proot-distro login "$DISTRO" -- true >/dev/null 2>&1; then
    echo "==> Installing minimal proot-distro '$DISTRO'..."
    proot-distro install "$DISTRO" || true
else
    echo "==> proot-distro '$DISTRO' is already installed."
fi

echo "==> Installing minimal APT packages in '$DISTRO'..."
proot-distro login "$DISTRO" -- /bin/sh -c "
    export DEBIAN_FRONTEND=noninteractive
    apt update -y
    apt install -y --no-install-recommends {{ .proot.apt_packages | join " " }}
    apt clean
    rm -rf /var/lib/apt/lists/*
"

echo "==> Installing Python data science stack in '$DISTRO'..."
proot-distro login "$DISTRO" -- /bin/sh -c "
    pip install --break-system-packages --upgrade pip
    pip install --default-timeout=120 --retries 10 --break-system-packages --upgrade {{ .proot.python_packages | join " " }}
"

{{- if .proot.agy_url }}

echo "==> Ensuring Antigravity CLI (agy) is installed in '$DISTRO'..."
proot-distro login "$DISTRO" -- /bin/sh -c "
    if [ ! -f /usr/local/bin/antigravity ]; then
        echo '==> Downloading antigravity-cli for ARM64...'
        curl -sSL '{{ .proot.agy_url }}' | tar -xz -C /usr/local/bin/
        chmod +x /usr/local/bin/antigravity
        ln -sfn /usr/local/bin/antigravity /usr/local/bin/agy
    fi
"
{{- end }}

