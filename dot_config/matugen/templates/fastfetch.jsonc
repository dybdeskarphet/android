{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "android_small",
    "color": {
      "1": "{{colors.primary.default.hex}}",
      "2": "{{colors.secondary.default.hex}}"
    },
    "padding": {
      "right": 2
    }
  },
  "display": {
    "color": {
      "keys": "{{colors.primary.default.hex}}",
      "title": "{{colors.secondary.default.hex}}"
    },
    "separator": " 󰄾 "
  },
  "modules": [
    {
      "type": "uptime",
      "key": "󰅐 Uptime"
    },
    {
      "type": "battery",
      "key": "󰂄 Battery"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory"
    },
    {
      "type": "disk",
      "key": "󰋊 Storage"
    },
    {
      "type": "localip",
      "key": "󰩟 Network",
      "showIpv4": true,
      "showIpv6": false
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
