# --- Declarative Debloat Data from .chezmoidata/debloat.yaml ---

{{ $modelsMap := dict }}
{{ if and (hasKey . "debloat") (hasKey .debloat "models") }}
  {{ $modelsMap = .debloat.models }}
{{ else if and (hasKey . "debloat") (hasKey .debloat "devices") }}
  {{ $modelsMap = .debloat.devices }}
