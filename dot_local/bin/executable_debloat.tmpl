# --- Help Menu ---
show_help() {
  cat <<EOF
${C_BOLD}Usage:${C_RESET} debloat [OPTIONS] [PACKAGE...]

Declarative Android debloater inspired by UAD-ng (Universal Android Debloater).
Clears cache/data, stops, uninstalls (user 0) or disables bloatware per device model.
Configurations are declaratively managed via ${C_BOLD}.chezmoidata/debloat.yaml${C_RESET}.

${C_BOLD}Options:${C_RESET}
  -m, --model <name>      Target specific device model (default: auto-detect from ro.product.model)
  -d, --device <name>     Alias for --model
  -n, --dry-run           Preview actions without modifying device state
  -f, --freeze            Only freeze/disable and clear data-cache (skip uninstall)
  -u, --uninstall-only    Only attempt uninstallation (skip disable fallback)
  -r, --restore           Restore / re-enable / reinstall existing packages
  -s, --status            Show current status of configured packages on device
  -l, --list              List all configured device models and packages
      --runner <type>     Force runner: 'rish' (Shizuku), 'su' (root), 'direct', 'adb'
  -h, --help              Show this help message

${C_BOLD}Examples:${C_RESET}
  debloat                 # Debloat common + current device model packages (auto-detected)
  debloat -n              # Dry-run preview without touching system
  debloat -m SM-S942B     # Target specific device model explicitly
  debloat -f              # Freeze: disable and clear data without uninstalling
  debloat -s              # Show status of all configured packages
  debloat -r              # Restore debloated packages
  debloat -r com.facebook.katana  # Restore a single package
  debloat com.samsung.android.bixby.agent # Debloat a specific package

EOF
}

# --- Runner Execution ---
detect_runner() {
  if [ -n "$FORCED_RUNNER" ]; then
    echo "$FORCED_RUNNER"
    return 0
  fi

  # Check if running natively on an Android device (Termux / Android environment)
  if [ -n "${TERMUX_VERSION:-}" ] || [ -f "/system/build.prop" ] || [ -d "/data/data/com.termux" ]; then
    # 1. Shizuku via rish (native in Termux via user mise setup)
    if command -v rish >/dev/null 2>&1; then
      if rish -c "true" </dev/null >/dev/null 2>&1; then
        echo "rish"
        return 0
      fi
    fi

    # 2. Direct pm execution (if running inside adb shell or privileged Termux environment)
    if command -v pm >/dev/null 2>&1; then
      if pm list packages </dev/null >/dev/null 2>&1; then
        echo "direct"
        return 0
      fi
    fi

    # 3. Root via su (Magisk / KernelSU / APatch)
    if command -v su >/dev/null 2>&1; then
      if su -c "true" </dev/null >/dev/null 2>&1; then
        echo "su"
        return 0
      fi
    fi
  fi

  # 4. Host ADB connection (when executed from a PC or via local adb in Termux)
  if command -v adb >/dev/null 2>&1; then
    local state
    state="$(adb get-state 2>/dev/null || true)"
    if [ "$state" = "device" ]; then
      echo "adb"
      return 0
    fi
  fi

  return 1
}

RUNNER=""

run_cmd() {
  case "$RUNNER" in
    rish)
      rish -c "$*"
      ;;
    su)
      su -c "$*"
      ;;
    adb)
      adb shell "$@"
      ;;
    direct)
      "$@"
      ;;
    *)
      log_error "Unknown runner: $RUNNER"
      return 1
      ;;
  esac
}

# --- Device Model Detection ---
detect_model() {
  # 1. Flag override
  if [ -n "$TARGET_MODEL" ]; then
    echo "$TARGET_MODEL"
    return 0
  fi

  # 2. Environment variable
  if [ -n "${MODEL:-}" ]; then
    echo "$MODEL"
    return 0
  fi
  if [ -n "${DEVICE:-}" ]; then
    echo "$DEVICE"
    return 0
  fi

  # 3. Template-configured default model (if any)
  local default_model
  default_model="{{ if and (hasKey . "debloat") (hasKey .debloat "default_model") }}{{ .debloat.default_model }}{{ end }}"
  if [ -n "$default_model" ]; then
    echo "$default_model"
    return 0
  fi

  # 4. Query getprop ro.product.model
  local raw_model=""
  if command -v getprop >/dev/null 2>&1; then
    raw_model="$(getprop ro.product.model 2>/dev/null | tr -d '\r' || true)"
  fi
  if [ -z "$raw_model" ]; then
    raw_model="$(run_cmd getprop ro.product.model 2>/dev/null | tr -d '\r' || true)"
  fi

  if [ -n "$raw_model" ]; then
    local raw_lower
    raw_lower="$(echo "$raw_model" | tr '[:upper:]' '[:lower:]')"
    for m in $(get_available_models); do
      if [ "$raw_lower" = "$(echo "$m" | tr '[:upper:]' '[:lower:]')" ]; then
        echo "$m"
        return 0
      fi
    done

    # Output detected model string even if unconfigured so caller can inform user
    echo "$raw_model"
    return 0
  fi

  return 1
}

# --- Package State Cache ---
ALL_PACKAGES=""
ENABLED_PACKAGES=""
DISABLED_PACKAGES=""

load_package_cache() {
  log_info "Fetching package state from device..."
  ALL_PACKAGES="$(run_cmd pm list packages -u 2>/dev/null | tr -d '\r' | sed 's/^package://' || true)"
  ENABLED_PACKAGES="$(run_cmd pm list packages -e 2>/dev/null | tr -d '\r' | sed 's/^package://' || true)"
  DISABLED_PACKAGES="$(run_cmd pm list packages -d 2>/dev/null | tr -d '\r' | sed 's/^package://' || true)"

  if [ -z "$ALL_PACKAGES" ]; then
    log_error "Failed to retrieve package list. Check device connection and permissions."
    exit 1
  fi
}

pkg_is_present() {
  echo "$ALL_PACKAGES" | grep -Fxq "$1"
}

pkg_is_enabled() {
  echo "$ENABLED_PACKAGES" | grep -Fxq "$1"
}

pkg_is_disabled() {
  echo "$DISABLED_PACKAGES" | grep -Fxq "$1"
}

pkg_is_uninstalled() {
  pkg_is_present "$1" && ! pkg_is_enabled "$1" && ! pkg_is_disabled "$1"
}

# --- Debloat Logic ---
debloat_single_package() {
  local pkg="$1"

  if ! pkg_is_present "$pkg"; then
    log_warn "${pkg}: not installed on device (skipped)"
    COUNT_SKIPPED=$((COUNT_SKIPPED + 1))
    return 0
  fi

  if pkg_is_uninstalled "$pkg"; then
    log_warn "${pkg}: already uninstalled for user 0"
    COUNT_ALREADY=$((COUNT_ALREADY + 1))
    return 0
  fi

  if pkg_is_disabled "$pkg"; then
    log_warn "${pkg}: already disabled"
    COUNT_ALREADY=$((COUNT_ALREADY + 1))
    return 0
  fi

  if [ "$DRY_RUN" = true ]; then
    log_dry "Would force-stop, clear data/cache, and debloat: ${C_BOLD}${pkg}${C_RESET}"
    return 0
  fi

  log_step "Debloating: ${C_BOLD}${pkg}${C_RESET}..."

  # 1. Stop app process and clear data/cache first (mimicking UAD-ng)
  run_cmd am force-stop "$pkg" >/dev/null 2>&1 || true
  run_cmd pm clear "$pkg" >/dev/null 2>&1 || run_cmd pm clear --user 0 "$pkg" >/dev/null 2>&1 || true

  local uninstalled=false
  local disabled=false

  # 2. Try uninstall for user 0 if not freeze-only
  if [ "$MODE" != "disable" ]; then
    local un_out
    un_out="$(run_cmd pm uninstall --user 0 "$pkg" 2>&1 || true)"
    if echo "$un_out" | grep -qi "Success"; then
      uninstalled=true
    fi
  fi

  if [ "$uninstalled" = true ]; then
    log_success "${pkg}: uninstalled for user 0 (data-cache cleared)"
    COUNT_UNINSTALLED=$((COUNT_UNINSTALLED + 1))
    return 0
  fi

  # 3. Fallback to disable / freeze if uninstall failed (or freeze mode requested)
  if [ "$MODE" != "uninstall" ]; then
    local dis_out
    dis_out="$(run_cmd pm disable-user --user 0 "$pkg" 2>&1 || true)"
    if echo "$dis_out" | grep -qi "disabled" || echo "$dis_out" | grep -qi "new state: disabled"; then
      disabled=true
    else
      dis_out="$(run_cmd pm disable "$pkg" 2>&1 || true)"
      if echo "$dis_out" | grep -qi "disabled" || echo "$dis_out" | grep -qi "new state: disabled"; then
        disabled=true
      fi
    fi
  fi

  if [ "$disabled" = true ]; then
    # Re-clear data after disabling to ensure nothing was written during shutdown
    run_cmd pm clear "$pkg" >/dev/null 2>&1 || run_cmd pm clear --user 0 "$pkg" >/dev/null 2>&1 || true
    log_success "${pkg}: disabled and cleared data-cache (system uninstall not permitted)"
    COUNT_DISABLED=$((COUNT_DISABLED + 1))
  else
    log_error "${pkg}: could not uninstall or disable"
    COUNT_FAILED=$((COUNT_FAILED + 1))
  fi
}

# --- Restore Logic ---
restore_single_package() {
  local pkg="$1"

  if ! pkg_is_present "$pkg"; then
    log_warn "${pkg}: not found on device ROM"
    COUNT_SKIPPED=$((COUNT_SKIPPED + 1))
    return 0
  fi

  if pkg_is_enabled "$pkg"; then
    log_warn "${pkg}: already active / enabled"
    COUNT_ALREADY=$((COUNT_ALREADY + 1))
    return 0
  fi

  if [ "$DRY_RUN" = true ]; then
    log_dry "Would restore: ${C_BOLD}${pkg}${C_RESET}"
    return 0
  fi

  log_step "Restoring: ${C_BOLD}${pkg}${C_RESET}..."

  local restored=false

  # 1. If uninstalled for user 0, reinstall existing system package
  local inst_out
  inst_out="$(run_cmd cmd package install-existing --user 0 "$pkg" 2>&1 || true)"
  if echo "$inst_out" | grep -qi "installed"; then
    restored=true
  else
    inst_out="$(run_cmd pm install-existing --user 0 "$pkg" 2>&1 || true)"
    if echo "$inst_out" | grep -qi "installed"; then
      restored=true
    fi
  fi

  # 2. Re-enable package if disabled
  local en_out
  en_out="$(run_cmd pm enable "$pkg" 2>&1 || true)"
  if echo "$en_out" | grep -qi "enabled" || echo "$en_out" | grep -qi "new state: enabled"; then
    restored=true
  fi

  if [ "$restored" = true ]; then
    log_success "${pkg}: successfully restored"
    COUNT_RESTORED=$((COUNT_RESTORED + 1))
  else
    log_error "${pkg}: could not restore package"
    COUNT_FAILED=$((COUNT_FAILED + 1))
  fi
}

# --- Status Display ---
show_package_status() {
  local pkg="$1"
  local status_label=""

  if ! pkg_is_present "$pkg"; then
    status_label="${C_DIM}Not present${C_RESET}"
  elif pkg_is_uninstalled "$pkg"; then
    status_label="${C_CYAN}Uninstalled (user 0)${C_RESET}"
  elif pkg_is_disabled "$pkg"; then
    status_label="${C_YELLOW}Disabled (data cleared)${C_RESET}"
  elif pkg_is_enabled "$pkg"; then
    status_label="${C_GREEN}Active${C_RESET}"
  else
    status_label="${C_DIM}Unknown${C_RESET}"
  fi

  printf "  %-48s %b\n" "$pkg" "$status_label"
}

# --- List Models and Packages ---
list_all() {
  printf "%sDeclarative Android Debloat Profiles (.chezmoidata/debloat.yaml):%s\n\n" "${C_BOLD}" "${C_RESET}"
  printf "%sCommon packages (applied to all devices):%s\n" "${C_CYAN}" "${C_RESET}"
  for p in $(get_common_packages); do
    printf "  - %s\n" "$p"
  done

  printf "\n%sDevice models:%s\n" "${C_CYAN}" "${C_RESET}"
  for m in $(get_available_models); do
    printf "  %s%s%s:\n" "${C_BOLD}" "$m" "${C_RESET}"
    for p in $(get_model_packages "$m"); do
      printf "    - %s\n" "$p"
    done
  done
}

# --- Parse Arguments ---
while [ $# -gt 0 ]; do
  case "$1" in
    -m|--model|-d|--device)
      TARGET_MODEL="$2"
      shift 2
      ;;
    -n|--dry-run)
      DRY_RUN=true
      shift
      ;;
    -f|--freeze)
      MODE="disable"
      shift
      ;;
    -u|--uninstall-only)
      MODE="uninstall"
      shift
      ;;
    -r|--restore)
      ACTION="restore"
      shift
      ;;
    -s|--status)
      ACTION="status"
      shift
      ;;
    -l|--list)
      ACTION="list"
      shift
      ;;
    --runner)
      FORCED_RUNNER="$2"
      shift 2
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    -*)
      log_error "Unknown option: $1"
      show_help
      exit 1
      ;;
    *)
      CHOSEN_PACKAGES="${CHOSEN_PACKAGES} $1"
      shift
      ;;
  esac
done

# If action is 'list', run and exit without needing runner or package checks
if [ "$ACTION" = "list" ]; then
  list_all
  exit 0
fi

# Detect runner
RUNNER="$(detect_runner || true)"
if [ -z "$RUNNER" ]; then
  log_error "No active privileged runner detected!"
  cat <<'EOF' >&2

Debloating on Android requires ADB or root permissions.
Please ensure one of the following is available:
  1. Shizuku is running (for 'rish')
  2. Device is rooted ('su')
  3. Connected via ADB ('adb shell debloat' or direct adb)
  4. Run inside an interactive ADB shell

You can force a runner with: debloat --runner <rish|su|adb|direct>
EOF
  exit 1
fi

log_info "Execution runner: ${C_BOLD}${RUNNER}${C_RESET}"

# Determine target device model
ACTIVE_MODEL="$(detect_model || true)"
MODEL_PACKAGES=""

if [ -n "$ACTIVE_MODEL" ]; then
  MODEL_PACKAGES="$(get_model_packages "$ACTIVE_MODEL" 2>/dev/null || true)"
  if [ -n "$MODEL_PACKAGES" ]; then
    log_info "Device model: ${C_BOLD}${ACTIVE_MODEL}${C_RESET}"
  else
    log_warn "Model '${ACTIVE_MODEL}' detected, but no matching configuration found in .chezmoidata/debloat.yaml."
    log_warn "Configured models: $(get_available_models | tr '\n' ' ')"
    log_warn "Proceeding with ${C_BOLD}common${C_RESET} packages only (or specify with: debloat -m <model>)"
  fi
else
  log_warn "Could not detect device model from ro.product.model."
  log_warn "Proceeding with ${C_BOLD}common${C_RESET} packages only (or specify with: debloat -m <model>)"
fi

# Determine package list
PACKAGES_TO_PROCESS=""
if [ -n "$CHOSEN_PACKAGES" ]; then
  PACKAGES_TO_PROCESS="$CHOSEN_PACKAGES"
else
  # Combine common packages + model-specific packages
  COMMON_LIST="$(get_common_packages || true)"
  PACKAGES_TO_PROCESS="$(printf "%s\n%s" "$COMMON_LIST" "$MODEL_PACKAGES" | grep -v '^[[:space:]]*$' | sort -u || true)"
fi

if [ -z "$PACKAGES_TO_PROCESS" ]; then
  log_warn "No packages to process."
  exit 0
fi

# Pre-load package cache from device
load_package_cache

# --- Execute Chosen Action ---
case "$ACTION" in
  status)
    log_info "Package status for model: ${C_BOLD}${ACTIVE_MODEL:-common}${C_RESET}"
    printf "  ${C_BOLD}%-48s %s${C_RESET}\n" "PACKAGE" "STATUS"
    printf "  %-48s %s\n" "------------------------------------------------" "------------------------"
    for pkg in $PACKAGES_TO_PROCESS; do
      show_package_status "$pkg"
    done
    ;;

  restore)
    log_info "Restoring packages..."
    [ "$DRY_RUN" = true ] && log_warn "Running in DRY-RUN mode. No changes will be applied."
    for pkg in $PACKAGES_TO_PROCESS; do
      restore_single_package "$pkg"
    done

    echo ""
    log_info "Restore summary: Restored: ${COUNT_RESTORED}, Already Active: ${COUNT_ALREADY}, Skipped: ${COUNT_SKIPPED}, Failed: ${COUNT_FAILED}"
    ;;

  debloat)
    log_info "Starting debloat process (mode: ${C_BOLD}${MODE}${C_RESET})..."
    [ "$DRY_RUN" = true ] && log_warn "Running in DRY-RUN mode. No changes will be applied."
    for pkg in $PACKAGES_TO_PROCESS; do
      debloat_single_package "$pkg"
    done

    echo ""
    log_info "Debloat summary: Uninstalled: ${COUNT_UNINSTALLED}, Disabled: ${COUNT_DISABLED}, Already debloated: ${COUNT_ALREADY}, Skipped: ${COUNT_SKIPPED}, Failed: ${COUNT_FAILED}"
    ;;
esac
