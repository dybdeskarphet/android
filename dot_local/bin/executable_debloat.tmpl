# --- Global Options & Flags ---
ACTION="debloat"          # debloat, restore, status, list
MODE="smart"              # smart (uninstall w/ disable fallback), disable, uninstall
DRY_RUN=false
TARGET_MODEL=""
FORCED_RUNNER=""
CHOSEN_PACKAGES=""

# --- Counters ---
COUNT_UNINSTALLED=0
COUNT_DISABLED=0
COUNT_RESTORED=0
COUNT_ALREADY=0
COUNT_SKIPPED=0
